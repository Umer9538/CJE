rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if current user is a superadmin
    function isSuperadmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Helper function to check if target user is a superadmin
    function isTargetSuperadmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'superadmin';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      // Allow delete only for Superadmin deleting non-Superadmin users (not themselves)
      allow delete: if isSuperadmin() &&
                       request.auth.uid != userId &&
                       !isTargetSuperadmin(userId);
    }

    // Schools collection - PUBLIC READ for registration
    // Schools need to be readable during registration (before user is authenticated)
    match /schools/{schoolId} {
      allow read: if true; // Allow public read for school selection during registration
      allow write: if isAuthenticated();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Meetings collection
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Attendance collection (legacy)
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Meeting Attendance collection
    match /meeting_attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Initiatives collection
    match /initiatives/{initiativeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Initiative comments collection
    match /initiative_comments/{commentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Initiative votes collection (NEW)
    match /initiative_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Polls collection
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Poll votes collection (NEW)
    match /poll_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Documents collection
    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Warnings collection
    match /warnings/{warningId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Activities collection
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // County settings collection
    match /county_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // GDS collection
    match /gds/{gdsId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
